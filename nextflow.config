/*
========================================================================================
    Configuration for CAREamics Denoising 
========================================================================================
*/

// Default params
params {
    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    trace_report_prefix   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    outdir                = 'results'
    target_data           = []
    val_data              = []
    val_target            = []

    // optional n2v, n2n & care
    num_epochs            = null
    num_steps             = null
    augmentations         = null
    n_val_patches         = null
    // optional n2v
    use_n2v2              = null
    n_channels            = null
    // optional n2n & care
    n_channels_in         = null
    n_channels_out        = null

    // optional pred options
    pred_batch_size       = null
    pred_data_type        = null
    tile_size             = null
    tile_overlap          = null
    pred_axes             = null
    pred_data_type        = null
    write_type            = null
}


// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/careamics custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Modules config
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes                                   = true
        process.beforeScript                         = 'echo $HOSTNAME'
        cleanup                                      = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        conda.channels       = ['conda-forge', 'bioconda']
        apptainer.enabled    = false
    }
    mamba {
        conda.enabled        = true
        conda.useMamba       = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }
    docker {
        docker.enabled       = true
        conda.enabled        = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }
    gpu {
        process {
            ext.use_gpu = true
        }
        docker.runOptions      = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions   = '--nv'
        singularity.runOptions = '--nv'
    }
    cpu {
        process {
            ext.use_gpu = false
        }
    }
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'gpu'
            clusterOptions = '--gres=gpu:1'
        }
    }

    // Test profile (uses stub execution)
    test {
        params.input      = 'test_data/*.tif'
        params.outdir     = 'test_results'
        params.algorithm  = 'n2v'
        params.num_epochs = 1
    }
}

/*
========================================================================================
    Report and Trace Configuration
========================================================================================
*/

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.trace_report_prefix}_execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.trace_report_prefix}_execution_report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.trace_report_prefix}_execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.trace_report_prefix}_pipeline_dag.html"
}
