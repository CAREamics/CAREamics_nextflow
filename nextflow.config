/*
========================================================================================
    Configuration for CAREamics Denoising 
========================================================================================
*/

params {
    custom_config_version = 'master'
    custom_config_base = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
    
    max_memory = '128.GB'
    max_cpus = 16
    max_time = '240.h'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Load nf-core institutional configs (uses params.custom_config_base)
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ?
    "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

workDir = null

profiles {
    
    // Standard profile (local execution)
    standard {
        process.executor = 'local'
    }
    
    // Docker profile
    docker {
        docker.enabled = true
        singularity.enabled = false
    }
    
    // Singularity profile
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        singularity.cacheDir='/dodrio/scratch/projects/2024_300/twoller/.apptainer'
    }
   apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        docker.enabled = false
        apptainer.cacheDir='/dodrio/scratch/projects/2024_300/twoller/.apptainer'
    }
    
    // Conda profile
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
    
    // AWS Batch profile
    aws {
        process {
            executor = 'awsbatch'
            queue = 'nextflow-queue'
        }
        aws.region = 'us-east-1'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
    
    // Google Cloud profile
    gcp {
        process.executor = 'google-lifesciences'
        google.project = 'your-project-id'
    }
    
    // SLURM cluster
    slurm {
        process {
            executor = 'slurm'
            queue = 'gpu'
            clusterOptions = '--gres=gpu:1'
        }
    }
    
    // Test profile (uses stub execution)
    test {
        params.input = 'test_data/*.tif'
        params.outdir = 'test_results'
        params.model = 'n2v'
        params.epochs = 1
    }
}

/*
========================================================================================
    Report and Trace Configuration
========================================================================================
*/

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
