nextflow_process {

    name "Test Process CAREAMICS_PREDICT"
    script "../main.nf"
    process "CAREAMICS_PREDICT"
    
    tag "modules"
    tag "modules_local"
    tag "careamics"
    tag "prediction"

    test("denoise test data") {

        when {
            process {
                config "/home/tatiana/hackathon_day1/nfcore_refactored_tests/nfcore_refactored/modules/careamics/predict/tests/nextflow.config"
                """
                input[0] = tuple(
                    [ id:'test_predict' ],
                    file(params.modules_testdata_base_path + 'n2v_test_sem/test.tif'),
                    '',
                    file(params.modules_testdata_base_path + 'n2v_test_sem/checkpoints/last.ckpt')
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.predictions.size() == 1 },
                { assert process.out.predictions[0][0] == [ id:'test_predict' ] },  // Check meta
                { assert process.out.predictions[0][1] },  // Check predictions exist
                { assert snapshot(process.out).match("predictions") }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                config "/home/tatiana/hackathon_day1/nfcore_refactored_tests/nfcore_refactored/modules/careamics/predict/tests/nextflow.config"
                """
                input[0] = tuple(
                    [ id:'test_stub' ],
                    file(params.modules_testdata_base_path + 'n2v_test_sem/test.tif'),
                    '',
                    file(params.modules_testdata_base_path + 'models/last.ckpt')
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
