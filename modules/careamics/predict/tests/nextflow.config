// Test configuration for CAREAMICS_PREDICT module

params {
    // Base path for test data - update this to your actual test data location
    modules_testdata_base_path = '/home/tatiana/test_careamics/'
}



// Process-specific configuration
process {
    withName: 'CAREAMICS_PREDICT' {
        // Test-specific arguments
        ext.args = '--tile_size "256 256" --tile_overlap "48 48" --write_type tiff --data_type tiff --axes YX --batch_size 32'
        
        // Optional: Override container for testing if needed
        // container = 'community.wave.seqera.io/library/careamics:0.0.16--973e324f2f759ff5'
    }
}
