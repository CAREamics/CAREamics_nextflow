nextflow_process {

    name "Test Process CAREAMICS_TRAIN_N2N"
    script "../main.nf"
    process "CAREAMICS_TRAIN_N2N"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "careamics"
    tag "training_n2n"

    test("train with generated tiff data") {

        setup {
            def testDir = new File(System.getProperty("java.io.tmpdir"), "careamics-nextflow-nf-test/train-n2n-real")
            testDir.mkdirs()
            def createData = [
                "python",
                "-c",
                "import numpy as np, pathlib, sys, tifffile; out = pathlib.Path(sys.argv[1]); rng = np.random.default_rng(2); (out / 'input').mkdir(exist_ok=True) ; (out / 'target').mkdir(exist_ok=True); [tifffile.imwrite(out / name, rng.random((64, 64), dtype=np.float32)) for name in ('input/train.tif', 'target/train.tif', 'input/val.tif', 'target/val.tif')]",
                testDir.absolutePath,
            ].execute()
            createData.waitFor()
            assert createData.exitValue() == 0 : createData.err.text
        }

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_n2n_real', model:'n2n' ],
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n-real/input/train.tif"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n-real/target/train.tif"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n-real/input/val.tif"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n-real/target/val.tif")
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.model.size() == 1 },
                { assert process.out.versions.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_n2n_real', model:'n2n' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert path(process.out.model[0][1]).exists() },
                { assert path(process.out.versions[0]).exists() }
            )
        }
    }

    test("stub with runtime test data") {

        options "-stub"

        setup {
            def testDir = new File(System.getProperty("java.io.tmpdir"), "careamics-nextflow-nf-test/train-n2n")
            testDir.mkdirs()
            new File(testDir, "train.tif").text = "stub"
            new File(testDir, "train_target.tiff").text = "stub"
            new File(testDir, "val.tif").text = "stub"
            new File(testDir, "val_target.tiff").text = "stub"
        }

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_n2n_stub', model:'n2n' ],
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n/train.tif"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n/train_target.tiff"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n/val.tif"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2n/val_target.tiff")
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.model.size() == 1 },
                { assert process.out.versions.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_n2n_stub', model:'n2n' ] },
                { assert process.out.model[0][0] == [ id:'test_n2n_stub', model:'n2n' ] },
                { assert path(process.out.careamics_config[0][1]).getFileName().toString() == "careamics.yaml" },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert path(process.out.model[0][1]).getFileName().toString() == "last.ckpt" },
                { assert path(process.out.model[0][1]).exists() },
                { assert path(process.out.versions[0]).getFileName().toString() == "versions.yml" },
                { assert path(process.out.versions[0]).exists() }
            )
        }
    }
}
