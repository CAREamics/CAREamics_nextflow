nextflow_process {

    name "Test Process CAREAMICS_TRAIN_N2N"
    script "../main.nf"
    process "CAREAMICS_TRAIN_N2N"

    tag "modules"
    tag "modules_local"
    tag "careamics"
    tag "training_n2n"

    test("train algorithm n2n") {

        when { 
            process {
                config "/home/tatiana/Denoising_careamics/modules/careamics/train/n2n/tests/nextflow.config"
                """
                input[0] = tuple(
                    [ id:'test_care' ],
                    file(params.modules_testdata_base_path + 'N2N_data/train/img.tif'),
                    '',
                    file(params.modules_testdata_base_path + 'N2N_data/target/img.tif'),
                    '',
                    [],
                    '',
                    [],
                    ''
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.config.size() == 1 },
                { assert process.out.model.size() == 1 },
                { assert path(process.out.config[0][1]).exists() },
                { assert path(process.out.model[0][1]).exists() },
                { assert snapshot(process.out).match("n2n") }
            )
        }
    }

    

    test("stub") {

        options "-stub"

        when {
            process {
                config "/home/tatiana/Denoising_careamics/modules/careamics/train/n2n/tests/nextflow.config"
                """
                input[0] = tuple(
                    [ id:'test_stub' ],
                    file(params.modules_testdata_base_path + 'N2N_data/train/img.tif'),
                    '',
                    file(params.modules_testdata_base_path + 'N2N_data/target/img.tif'),
                    '',
                    [],
                    '',
                    [],
                    ''
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("stub") }
            )
        }
    }
}
