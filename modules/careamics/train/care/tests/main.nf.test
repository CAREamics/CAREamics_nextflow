nextflow_process {

    name "Test Process CAREAMICS_TRAIN_CARE"
    script "../main.nf"
    process "CAREAMICS_TRAIN_CARE"

    tag "modules"
    tag "modules_local"
    tag "careamics"
    tag "training_care"

    test("train model care") {

        when { 
            process {
                config "/home/tatiana/Denoising_careamics/modules/careamics/train/care/tests/nextflow.config"
                """
                input[0] = tuple(
                    [ id:'test_care', model:'care' ],  // Added 'model' to meta
                    file(params.modules_testdata_base_path + 'U2OS/train/low/img_0042.tif'),
                    file(params.modules_testdata_base_path + 'U2OS/train/GT/img_0042.tif'),
                    [],
                    []
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.config.size() == 1 },
                { assert process.out.model.size() == 1 },
                { assert path(process.out.config[0][1]).exists() },
                { assert path(process.out.model[0][1]).exists() },
                { assert snapshot(process.out).match("care") }
            )
        }
    }

    

    test("stub") {

        options "-stub"

        when {
            process {
                config "/home/tatiana/Denoising_careamics/modules/careamics/train/care/tests/nextflow.config"
                """
                input[0] = tuple(
                    [ id:'test_stub', model:'care' ],  // Added 'model' to meta
                    file(params.modules_testdata_base_path + 'U2OS/train/low/img_0042.tif'),
                    file(params.modules_testdata_base_path + 'U2OS/train/GT/img_0042.tif'),
                    [],
                    []
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("stub") }
            )
        }
    }
}
