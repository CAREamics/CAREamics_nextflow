nextflow_process {

    name "Test Process CAREAMICS_TRAIN_N2V"
    script "../main.nf"
    process "CAREAMICS_TRAIN_N2V"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "careamics"
    tag "training_n2v"

    test("train with generated tiff data") {

        setup {
            def testDir = new File(System.getProperty("java.io.tmpdir"), "careamics-nextflow-nf-test/train-n2v-real")
            testDir.mkdirs()
            def createData = [
                "python",
                "-c",
                "import numpy as np, pathlib, sys, tifffile; out = pathlib.Path(sys.argv[1]); rng = np.random.default_rng(1); tifffile.imwrite(out / 'train.tif', rng.random((64, 64), dtype=np.float32)); tifffile.imwrite(out / 'val.tif', rng.random((64, 64), dtype=np.float32))",
                testDir.absolutePath,
            ].execute()
            createData.waitFor()
            assert createData.exitValue() == 0 : createData.err.text
        }

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_n2v_real', model:'n2v' ],
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2v-real/train.tif"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2v-real/val.tif")
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.model.size() == 1 },
                { assert process.out.versions.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_n2v_real', model:'n2v' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert path(process.out.model[0][1]).exists() },
                { assert path(process.out.versions[0]).exists() }
            )
        }
    }

    test("stub with runtime test data") {

        options "-stub"

        setup {
            def testDir = new File(System.getProperty("java.io.tmpdir"), "careamics-nextflow-nf-test/train-n2v")
            new File(testDir, "train").mkdirs()
            new File(testDir, "train/image.tiff").text = "stub"
            new File(testDir, "val.tif").text = "stub"
        }

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_n2v_stub', model:'n2v' ],
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2v/train"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/train-n2v/val.tif")
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.model.size() == 1 },
                { assert process.out.versions.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_n2v_stub', model:'n2v' ] },
                { assert process.out.model[0][0] == [ id:'test_n2v_stub', model:'n2v' ] },
                { assert path(process.out.careamics_config[0][1]).getFileName().toString() == "careamics.yaml" },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert path(process.out.model[0][1]).getFileName().toString() == "last.ckpt" },
                { assert path(process.out.model[0][1]).exists() },
                { assert path(process.out.versions[0]).getFileName().toString() == "versions.yml" },
                { assert path(process.out.versions[0]).exists() }
            )
        }
    }
}
