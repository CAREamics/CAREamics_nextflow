nextflow_process {

    name "Test Process CAREAMICS_PREDICT"
    script "../main.nf"
    process "CAREAMICS_PREDICT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_careamics"
    tag "modules_local"
    tag "careamics"
    tag "predict"
    tag "prediction"

    test("stub with runtime test data") {

        options "-stub"

        setup {
            def testDir = new File(System.getProperty("java.io.tmpdir"), "careamics-nextflow-nf-test/predict")
            new File(testDir, "data").mkdirs()
            new File(testDir, "data/image.tif").text = "stub"
            new File(testDir, "last.ckpt").text = "stub"
        }

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_predict_stub' ],
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/predict/data"),
                    file("\${System.getProperty('java.io.tmpdir')}/careamics-nextflow-nf-test/predict/last.ckpt")
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.predictions.size() == 1 },
                { assert process.out.versions.size() == 1 },
                { assert process.out.predictions[0][0] == [ id:'test_predict_stub' ] },
                { assert path(process.out.predictions[0][1]).getFileName().toString() == "test_predict_stub_denoised.tiff" },
                { assert path(process.out.predictions[0][1]).exists() },
                { assert path(process.out.versions[0]).getFileName().toString() == "versions.yml" },
                { assert path(process.out.versions[0]).exists() }
            )
        }
    }
}
