nextflow_process {

    name "Test Process CAREAMICS_CONFIGN2N"
    script "../main.nf"
    process "CAREAMICS_CONFIGN2N"
    config "./nextflow.config"

    tag "modules"
    tag "modules_careamics"
    tag "modules_local"
    tag "careamics"
    tag "careamics/confign2n"

    test("careamics_confign2n") {

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_careamics_confign2n', model:'n2n' ],
                    'test_careamics_confign2n',
                    'tiff',
                    'YX',
                    '64 64',
                    8
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_careamics_confign2n', model:'n2n' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert process.out.versions_careamics.size() == 1 },
                { assert process.out.versions_careamics[0][1] == "careamics" },
                { assert process.out.versions_careamics[0][2] instanceof String },
            )
        }
    }

    test("stub careamics_confign2n") {

        options "-stub"

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_careamics_confign2n', model:'n2n' ],
                    'test_careamics_confign2n',
                    'tiff',
                    'YX',
                    '64 64',
                    8
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.versions_careamics.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_careamics_confign2n', model:'n2n' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert process.out.versions_careamics[0][1] == "careamics" },
                { assert process.out.versions_careamics[0][2] instanceof String },
            )
        }
    }
}
