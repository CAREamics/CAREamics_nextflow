nextflow_process {

    name "Test Process CAREAMICS_CONFIGN2V"
    script "../main.nf"
    process "CAREAMICS_CONFIGN2V"
    config "./nextflow.config"

    tag "modules"
    tag "modules_careamics"
    tag "modules_local"
    tag "careamics"
    tag "careamics/confign2v"

    test("careamics_confign2v") {

        when {
            params {
                module_args = '--seed 42'
            }

            process {
                """
                input[0] = tuple(
                    [ id:'test_careamics_confign2v', model:'n2v' ],
                    'test_careamics_confign2v',
                    'tiff',
                    'YX',
                    '64 64',
                    8
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_careamics_confign2v', model:'n2v' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert path(process.out.careamics_config[0][1]).text.contains('seed: 42') },
                { assert process.out.versions_careamics.size() == 1 },
                { assert process.out.versions_careamics[0][1] == "careamics" },
                { assert process.out.versions_careamics[0][2] instanceof String },
                { assert snapshot(process.out).match() },
            )
        }
    }

    test("stub careamics_confign2v") {

        options "-stub"

        when {
            params {
                module_args = ''
            }

            process {
                """
                input[0] = tuple(
                    [ id:'test_careamics_confign2v', model:'n2v' ],
                    'test_careamics_confign2v',
                    'tiff',
                    'YX',
                    '64 64',
                    8
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.versions_careamics.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_careamics_confign2v', model:'n2v' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert process.out.versions_careamics[0][1] == "careamics" },
                { assert process.out.versions_careamics[0][2] instanceof String },
                { assert snapshot(process.out).match() },
            )
        }
    }
}
