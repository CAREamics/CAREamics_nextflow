nextflow_process {

    name "Test Process CAREAMICS_CONFIGCARE"
    script "../main.nf"
    process "CAREAMICS_CONFIGCARE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_careamics"
    tag "modules_local"
    tag "careamics"
    tag "careamics/configcare"

    test("careamics_configcare") {

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_careamics_configcare', model:'care' ],
                    'test_careamics_configcare',
                    'tiff',
                    'YX',
                    '64 64',
                    8
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_careamics_configcare', model:'care' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert process.out.versions_careamics.size() == 1 },
                { assert process.out.versions_careamics[0][1] == "careamics" },
                { assert process.out.versions_careamics[0][2] instanceof String },
            )
        }
    }

    test("stub careamics_configcare") {

        options "-stub"

        when {
            process {
                """
                input[0] = tuple(
                    [ id:'test_careamics_configcare', model:'care' ],
                    'test_careamics_configcare',
                    'tiff',
                    'YX',
                    '64 64',
                    8
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.careamics_config.size() == 1 },
                { assert process.out.versions_careamics.size() == 1 },
                { assert process.out.careamics_config[0][0] == [ id:'test_careamics_configcare', model:'care' ] },
                { assert path(process.out.careamics_config[0][1]).exists() },
                { assert process.out.versions_careamics[0][1] == "careamics" },
                { assert process.out.versions_careamics[0][2] instanceof String },
            )
        }
    }
}
