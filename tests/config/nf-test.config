params {
    publish_dir_mode = "copy"
}

nextflow.enable.moduleBinaries = true

process {
    executor = 'local'
    cpus     = 1
    memory   = 1.GB
    time     = 1.h
}

profiles {
    conda {
        conda.enabled = true
    }

    docker {
        docker.enabled = true
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
