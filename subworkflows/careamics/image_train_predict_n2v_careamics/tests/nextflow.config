process {
    beforeScript = '''
        export MPLCONFIGDIR="${TMPDIR:-/tmp}/careamics-nextflow-nf-test/mplconfig"
        export XDG_CACHE_HOME="${TMPDIR:-/tmp}/careamics-nextflow-nf-test/xdg-cache"
        mkdir -p "$MPLCONFIGDIR" "$XDG_CACHE_HOME"
    '''

    withName: CAREAMICS_CONFIGN2V {
        ext.args = { params.module_args ?: '' }
    }
}
